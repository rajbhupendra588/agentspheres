# ---------------------------------------------------------------------------
# AgentSphere environment
# Local E2E: AS_GATEWAY_OPEN=true (default in docker-compose.yml)
# Production: AS_GATEWAY_OPEN=false + strong secrets (see docker-compose.prod.yml)
# ---------------------------------------------------------------------------

# REQUIRED in locked/production mode (min 32 chars). Never commit real values.
AS_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# REQUIRED in locked/production mode for minting JWTs (console server uses this).
AS_BOOTSTRAP_SECRET=replace-with-another-long-random-secret

# false = JWT required on /mesh/* (production). true = local E2E convenience.
AS_GATEWAY_OPEN=true

# Multi-tenant defaults for local agents / demos
AS_TENANT_ID=default
# AS_PROJECT_ID=demo-project

AS_AUTH_URL=http://auth:8081
AS_REGISTRY_URL=http://registry:8082
AS_DISCOVERY_URL=http://discovery:8083
AS_RUNTIME_URL=http://runtime:8084
AS_WORKFLOW_URL=http://workflow:8085
AS_TOOL_ENGINE_URL=http://tool-engine:8086
AS_MEMORY_URL=http://memory:8087
AS_NOTIFICATION_URL=http://notification:8088
AS_DATABASE_URL=postgres://agentsphere:agentsphere@postgres:5432/agentsphere
AS_REDIS_URL=redis://redis:6379
AS_NATS_URL=nats://nats:4222
# Flyway-compatible SQL dir (Compose default: /app/db/migrations)
# AS_MIGRATIONS_DIR=./db/migrations
AS_TEMPORAL_ADDRESS=temporal:7233
AS_GATEWAY_URL=http://gateway:8080
AS_GATEWAY_PUBLIC_URL=http://localhost:8080

# Console (server-side)
# AS_CONSOLE_PUBLIC_GATEWAY=
# Rate limits / proxy (optional)
# AS_RATE_LIMIT_MAX=200
# AS_RATE_LIMIT_WINDOW_MS=60000
# AS_AUTH_RATE_LIMIT_MAX=30
# AS_AUTH_RATE_LIMIT_WINDOW_MS=60000
# AS_PROXY_TIMEOUT_MS=60000
# AS_OPENAPI_PATH=/absolute/path/to/openapi.yaml

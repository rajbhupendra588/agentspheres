{
  "name": "@agentsphere/workflow",
  "version": "0.1.0",
  "description": "AgentSphere workflow orchestration service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentsphere/common": "workspace:*",
    "@agentsphere/contracts": "workspace:*",
    "fastify": "^5.12.1",
    "nats": "^2.28.2",
    "zod": "^3.24.1"
  }
}

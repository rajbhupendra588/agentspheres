{
  "name": "@agentsphere/gateway",
  "version": "0.1.0",
  "description": "AgentSphere edge gateway — reverse proxy to mesh APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentsphere/common": "workspace:*",
    "@agentsphere/contracts": "workspace:*",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7"
  }
}

{
  "name": "@agentsphere/sdk",
  "version": "0.1.0",
  "description": "AgentSphere Agent SDK — sidecar, registration, and mesh client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@agentsphere/common": "workspace:*",
    "@agentsphere/contracts": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^3.24.1"
  }
}

    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@agentsphere/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
